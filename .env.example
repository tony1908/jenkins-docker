# Copia este archivo como .env y ajusta las rutas a tu maquina.
# No guardes usuarios, tokens, passwords ni valores privados en este archivo.
# Las credenciales van en Jenkins o en tu ~/.m2/settings.xml local.

# Puerto del host para acceder al registry local.
# Dentro de Docker y Minikube se usa siempre registry:5000.
REGISTRY_HOST_PORT=5001

# Red Docker del perfil de Minikube.
MINIKUBE_DOCKER_NETWORK=minikube

# Ruta absoluta a un checkout local opcional.
# Jenkins lo vera en /workspace/project.
# LOCAL_PROJECT_PATH=/ruta/absoluta/a/tu/proyecto

# Ruta absoluta a tu cache local de Maven.
# Por defecto Compose usa ${HOME}/.m2.
# Jenkins lo vera en /var/jenkins_home/.m2.
# MAVEN_M2_PATH=/ruta/absoluta/a/tu/.m2

# Ruta absoluta al repositorio SVN local.
# Debe ser el directorio que contiene conf/, db/, hooks/, locks/ y format.
# Jenkins lo vera en /svn/external-repo.
# SVN_REPO_PATH=/ruta/absoluta/a/tu/svn-repo/repo

# URL SVN que usara el job generado svn-dind-sample.
# Usa la ruta del contenedor, no la ruta /Users/... del host.
# SVN_REMOTE=file:///svn/external-repo/trunk
# SVN_REMOTE=file:///svn/external-repo/branches/mi-rama
